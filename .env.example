# Hyper Alpha Arena - Environment Configuration Template
# Copy this file to .env and fill in your values

# =================================================================
# Hyperliquid Trading Configuration (REQUIRED for real trading)
# =================================================================

# Encryption key for private key storage
# HYPERLIQUID_ENCRYPTION_KEY is automatically generated and persisted by Docker

# Hyperliquid defaults (optional, can be configured per account in UI)
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# Database Configuration (Auto-configured in Docker)
# =================================================================
# These are automatically set by docker-compose.yml
# DATABASE_URL=postgresql://alpha_user:alpha_pass@postgres:5432/alpha_arena
# SNAPSHOT_DATABASE_URL=postgresql://alpha_user:alpha_pass@postgres:5432/alpha_snapshots

# Local development startup script defaults.
# Use scripts/start-dev.ps1 for host-mode backend/frontend development.
BACKEND_PORT=20084
FRONTEND_PORT=20080
POSTGRES_PORT=25532
ALPHA_TRACE_MYSQL_PORT=23307
ALPHA_TRACE_CLICKHOUSE_HTTP_PORT=28123
ALPHA_TRACE_CLICKHOUSE_NATIVE_PORT=29000

# AlphaTrace product persistence defaults to MySQL.
# JSON remains available as a fallback/migration source.
ALPHA_TRACE_AGENT_RUN_STORE=mysql
ALPHA_TRACE_DOMAIN_STORE=mysql
ALPHA_TRACE_AGENT_RUN_STORE_PATH=/app/data/alpha_trace_agent_runs.json
ALPHA_TRACE_MYSQL_DATABASE_URL=mysql+pymysql://alpha_user:alpha_pass@mysql:3306/alpha_trace?charset=utf8mb4
ALPHA_TRACE_CLICKHOUSE_URL=http://clickhouse:8123
ALPHA_TRACE_CLICKHOUSE_USER=alpha_user
ALPHA_TRACE_CLICKHOUSE_PASSWORD=alpha_pass
ALPHA_TRACE_ETF_INDEX_VALUATION_TABLE=alpha_trace.etf_index_valuation_daily
ALPHA_TRACE_FILE_IMPORT_DIR=/app/data/test
ALPHATRACE_BACKEND_LOG_PATH=/app/logs/backend-runtime.log

# Standalone ClickHouse smoke scripts over a local SSH tunnel.
# Start the tunnel before running pnpm clickhouse:* commands.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=18123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=<your-clickhouse-password>
CLICKHOUSE_DATABASE=monitor

# =================================================================
# Optional: Custom AI Model Configuration
# =================================================================
# If you want to set default API keys (can also be configured per account in UI)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# =================================================================
# Optional: Hyper Insight Integration
# =================================================================
# Login-based Hyper Insight integration uses the same Casdoor account session
# that is already synced from Hyper Alpha Arena after the user signs in.
# Only the base URL is needed here unless the deployment wants to override it.
HYPER_INSIGHT_API_BASE_URL=https://hyper.akooi.com

# =================================================================
# Optional: OpenClaw Channel Bridge
# =================================================================
# Shared secret for OpenClaw -> Hyper AI webhook calls.
# ECS-side OpenClaw should call POST /api/bot/openclaw/webhook with:
# Authorization: Bearer <this-token>
# You can also configure this at runtime via POST /api/bot/openclaw/connect.
# ALPHATRACE_OPENCLAW_BRIDGE_TOKEN=replace-with-a-long-random-token

# Optional ECS-side adapter settings for scripts/openclaw_hyperalpha_bridge.py.
# OPENCLAW_WS_URL=ws://120.27.194.30:18789/sce4tf6i
# OPENCLAW_GATEWAY_TOKEN=replace-with-regenerated-openclaw-gateway-token
# OPENCLAW_GATEWAY_PASSWORD=replace-with-openclaw-shared-password
# OPENCLAW_SESSION_KEY=agent:main:main
# OPENCLAW_DEVICE_KEY_PATH=.openclaw-device-key.pem
# HYPER_ALPHA_WEBHOOK_URL=http://127.0.0.1:28802/api/bot/openclaw/webhook
# HYPER_ALPHA_BRIDGE_TOKEN=replace-with-hyper-alpha-bridge-token
